+
+/**
+ * @brief Returns the engine userid for a connected client, or -1.
+ */
+extern "C" PLUGIN_API int GetClientUserID(int playerSlot) {
+	auto player = g_PlayerManager.ToPlayer(CPlayerSlot(playerSlot));
+	if (!player || !player->IsConnected()) {
+		return -1;
+	}
+	return g_pEngineServer->GetPlayerUserId(CPlayerSlot(playerSlot)).Get();
 }
 
